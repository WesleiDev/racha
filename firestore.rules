rules_version = '2';

// Regras do Racha — cole no console (Firestore Database → Regras) ou publique
// com `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // perfil: só o dono
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // grupo: membros leem; admins escrevem; entrar pelo link = só adicionar o próprio uid
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.admins
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
        )
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /players/{playerId} {
        allow read, write: if isMember(groupId);
      }

      match /matches/{matchId} {
        allow read, write: if isMember(groupId);
      }
    }

    // convite: resumo público pra quem tem o link (precisa estar logado)
    match /invites/{token} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // placar ao vivo: leitura pública (espectador sem login), escrita de quem joga
    match /live/{token} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
